#!/bin/sh

set -eu
. "${DOTFILES_ROOT:?}/scripts/lib.sh"

has apt-get || die 'apt-get is required on Debian/Ubuntu'

PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export PATH

# Neovim 0.11+ is required by this configuration. Ubuntu's Neovim PPA keeps
# the package recent while still allowing apt to own it.
# shellcheck disable=SC1091
. /etc/os-release

apt_update() {
	if run_as_root apt-get update; then
		return 0
	fi

	warn 'apt update reported an error in one or more configured repositories'
	warn 'continuing with indexes from repositories that APT updated successfully'
	warn 'APT rejected the failed repository metadata; repair that source separately'
}

install_github_cli() {
	if has gh; then
		return 0
	fi

	info 'Installing GitHub CLI from its official APT repository'
	if [ "$DOTFILES_DRY_RUN" -eq 1 ]; then
		printf '%s\n' '+ add the signed GitHub CLI APT repository and install gh'
		return 0
	fi

	gh_key_tmp=$(mktemp "${TMPDIR:-/tmp}/githubcli-keyring.XXXXXX")
	gh_source_tmp=$(mktemp "${TMPDIR:-/tmp}/githubcli-source.XXXXXX")
	trap 'rm -f "$gh_key_tmp" "$gh_source_tmp"' EXIT HUP INT TERM

	curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o "$gh_key_tmp"
	printf '%s  %s\n' \
		'6084d5d7bd8e288441e0e94fc6275570895da18e6751f70f057485dc2d1a811b' \
		"$gh_key_tmp" | sha256sum -c - >/dev/null

	printf 'deb [arch=%s signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' \
		"$(dpkg --print-architecture)" > "$gh_source_tmp"

	run_as_root install -d -m 755 /etc/apt/keyrings /etc/apt/sources.list.d
	run_as_root install -m 644 "$gh_key_tmp" /etc/apt/keyrings/githubcli-archive-keyring.gpg
	run_as_root install -m 644 "$gh_source_tmp" /etc/apt/sources.list.d/github-cli.list
	apt_update
	run_as_root apt-get install -y gh
}

apt_update
if [ "${ID:-}" = ubuntu ]; then
	run_as_root apt-get install -y software-properties-common
	if ! grep -Rqs 'neovim-ppa.*unstable' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
		run_as_root add-apt-repository -y ppa:neovim-ppa/unstable
		apt_update
	fi
fi

set --
while IFS= read -r package || [ -n "$package" ]; do
	case "$package" in ''|'#'*) continue ;; esac
	set -- "$@" "$package"
done < "$DOTFILES_ROOT/packages/debian.txt"

[ "$#" -gt 0 ] && run_as_root apt-get install -y "$@"

install_github_cli

while IFS= read -r package || [ -n "$package" ]; do
	case "$package" in ''|'#'*) continue ;; esac
	if apt-cache show "$package" >/dev/null 2>&1; then
		run_as_root apt-get install -y "$package"
	else
		warn "optional apt package is unavailable: $package"
	fi
done < "$DOTFILES_ROOT/packages/debian-optional.txt"

if ! has delta; then
	info 'git-delta is unavailable through apt; installing the latest release with Cargo'
	run cargo install --locked git-delta
	run mkdir -p "$HOME/.local/bin"
	if [ ! -e "$HOME/.local/bin/delta" ]; then
		run ln -s "$HOME/.cargo/bin/delta" "$HOME/.local/bin/delta"
	fi
fi

# Debian calls fd(1) "fdfind" to avoid a package-name collision.
if ! has fd && has fdfind; then
	run mkdir -p "$HOME/.local/bin"
	if [ ! -e "$HOME/.local/bin/fd" ]; then
		run ln -s "$(command -v fdfind)" "$HOME/.local/bin/fd"
	fi
fi
